# Settings for compose.yml. install.sh writes .env for you; this file lists
# what it can hold. Change a value, then: voxhub restart

# --- address -------------------------------------------------------------
# Your domain, or <ip-with-dashes>.sslip.io if you have none.
DOMAIN=203-0-113-10.sslip.io
# Public IPv4 the calls go to. On a box with several, the reachable one.
NODE_IP=203.0.113.10
# HTTPS port of the site. 443 if it is free; otherwise e.g. 8443.
HTTPS_PORT=443
# Caddy answers here for the certificate check and redirects to https.
HTTP_PORT=80

# --- certificate ---------------------------------------------------------
# auto     — Let's Encrypt via Caddy (needs port 80 or 443 of this box)
# files    — your own certificate, e.g. from certbot (TLS_DIR/TLS_CERT/TLS_KEY)
# internal — self-signed, tests only
TLS_MODE=auto
# For TLS_MODE=files: the host folder that is mounted at /ext-certs, and the
# paths inside it.
# TLS_DIR=/etc/letsencrypt
# TLS_CERT=/ext-certs/live/vox.example.com/fullchain.pem
# TLS_KEY=/ext-certs/live/vox.example.com/privkey.pem

# --- secrets (generated by install.sh) -----------------------------------
LIVEKIT_API_KEY=APIxxxxxxxxxxxx
LIVEKIT_API_SECRET=replace-me
# Enter it on the first screen to create the server and its owner.
SETUP_CODE=ABCD-EFGH

# --- ports on this box ---------------------------------------------------
# Open to the internet: RTC_TCP_PORT, RTC_UDP_PORT/udp, TURN_UDP_PORT/udp,
# TURN_TLS_PORT, plus HTTPS_PORT and HTTP_PORT. The other two stay local.
APP_PORT=3000
LIVEKIT_PORT=7880
RTC_TCP_PORT=7881
RTC_UDP_PORT=7882
TURN_UDP_PORT=3478
TURN_TLS_PORT=5349

# --- the rest ------------------------------------------------------------
# People in one channel at once.
MAX_PARTICIPANTS=10
# Channels created on first setup.
ROOMS=general,games,music
# App image tag; `voxhub update` keeps it in step with the code.
VOXHUB_TAG=main
