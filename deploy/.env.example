# Copy to .env and fill in. Generate a key pair with:
#   docker run --rm livekit/livekit-server generate-keys
LIVEKIT_KEYS=APIxxxxxxxxxxxx: your-secret-here

# Public IPv4 the SFU advertises to clients. Must be an address they can reach,
# and the one media actually leaves from.
VOXHUB_NODE_IP=203.0.113.10
